# Copy to .env.local (development) or provide as real environment variables (production).

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Public URL of the site (https in production)
BETTER_AUTH_URL=http://localhost:3000

DATABASE_PATH=./data/symposium.db

# When subscribing to talks opens / closes (ISO 8601 with offset)
REGISTRATION_OPENS_AT=2027-02-01T12:00:00+01:00
# REGISTRATION_CLOSES_AT=2027-03-16T23:59:00+01:00

# SMTP (required in production; in development mails are printed to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GEWIS Lustrum Symposium <noreply@gewis.nl>"
