# Copy to .env.local (development) or provide as real environment variables (production).

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Public URL of the site (https in production)
BETTER_AUTH_URL=http://localhost:3000

# Postgres. Locally: docker compose up -d. Add ?sslmode=verify-full for servers with TLS.
DATABASE_URL=postgres://symposium:symposium@localhost:5432/symposium
# Connections per server instance (use 3 on serverless hosts such as Vercel)
DATABASE_POOL_MAX=10

# Admin dashboard (/admin). Generate with: npm run admin:credentials
# Only hashes go here; the username and password themselves are shown once.
ADMIN_USERNAME_SHA256=
ADMIN_PASSWORD_HASH=

# SMTP (required in production). Locally: Mailpit from compose.yaml, inbox at http://localhost:8025
# Without SMTP_HOST in development, mails are printed to the console instead.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GEWIS Lustrum Symposium <noreply@gewis.nl>"
