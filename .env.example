# Copy to .env.local (development) or provide as real environment variables (production).

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Public URL of the site (https in production)
BETTER_AUTH_URL=http://localhost:3000

DATABASE_PATH=./data/symposium.db

# Admin dashboard (/admin). Generate with: npm run admin:credentials
# Only hashes go here; the username and password themselves are shown once.
ADMIN_USERNAME_SHA256=
ADMIN_PASSWORD_HASH=

# SMTP (required in production; in development mails are printed to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GEWIS Lustrum Symposium <noreply@gewis.nl>"
